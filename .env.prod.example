# ============================================================
# 生产环境配置模板 (.env.prod.example)
# 用法: 在服务器上 cp .env.prod.example .env.prod, 填入生产真实值
# 本文件进 git; .env.prod 不进 git
#
# 重要: APP_ENV 不写在这里, 由部署层注入:
#   docker-compose:  environment: [APP_ENV=prod]
#   或启动命令:       docker run -e APP_ENV=prod ...
# 程序在 APP_ENV=prod 时会强制校验: APP_DEBUG 必须为 false、
# JWT_SECRET 不能是开发默认值, 否则直接拒绝启动。
# ============================================================

# ---------- 应用配置 ----------
APP_NAME=安心保AI保险顾问
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8001

# ---------- 日志配置(生产不要用 DEBUG, 避免刷大量 SQL) ----------
LOGGING_LEVEL=INFO

# ---------- PostgreSQL 数据库(生产库) ----------
DB_HOST=生产数据库地址
DB_PORT=5432
DB_NAME=insurance
DB_USER=生产数据库账号
DB_PASSWORD=生产数据库强密码
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------- 大模型配置 ----------
DEEPSEEK_API_KEY=***
CHAT_MODEL=deepseek-v4-flash

DASHSCOPE_API_KEY=***
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- MinerU 文档解析 ----------
MINERU_TOKEN=***

# ---------- 阿里云 ----------
ALI_API_KEY=***
ALI_BASE_URL=生产阿里云服务地址

# ---------- Milvus 向量数据库(生产地址) ----------
MILVUS_HOST=生产Milvus地址
MILVUS_PORT=19530

# ---------- JWT 鉴权 ----------
# 生产必填! 用随机强密钥, 例如: python -c "import secrets;print(secrets.token_hex(32))"
# 不设置或仍为开发默认值时, 程序拒绝启动
JWT_SECRET=***
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
