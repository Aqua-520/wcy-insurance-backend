# ============================================================
# 开发环境配置模板 (.env.dev.example)
# 用法: cp .env.dev.example .env.dev 后填入本机真实值
# 本文件进 git; .env.dev 不进 git, 切勿把真实密钥提交上去
# 加载哪个文件由操作系统环境变量 APP_ENV 决定(默认 dev),
# APP_ENV 本身不要写在这个文件里(见 README / docker-compose)
# ============================================================

# ---------- 应用配置 ----------
APP_NAME=安心保AI保险顾问
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8001

# ---------- 日志配置 ----------
# 可选: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOGGING_LEVEL=INFO

# ---------- PostgreSQL 数据库 ----------
DB_HOST=你的虚拟机IP          # 例如 192.168.137.128
DB_PORT=5432
DB_NAME=insurance
DB_USER=insurance
DB_PASSWORD=你的数据库密码
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------- 大模型配置 ----------
DEEPSEEK_API_KEY=***
CHAT_MODEL=deepseek-v4-flash

# 阿里云百炼(可选, 用不到可留空)
DASHSCOPE_API_KEY=***
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- MinerU 文档解析 ----------
MINERU_TOKEN=***

# ---------- 阿里云(可选) ----------
ALI_API_KEY=***
ALI_BASE_URL=你的阿里云服务地址

# ---------- Milvus 向量数据库 ----------
MILVUS_HOST=你的虚拟机IP       # 例如 192.168.137.128
MILVUS_PORT=19530

# ---------- JWT 鉴权 ----------
# 开发环境: 不设置(整行删掉) JWT_SECRET, 程序会用代码内置开发默认值
# JWT_SECRET=dev-o...n
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
